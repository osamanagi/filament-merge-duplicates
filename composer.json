{
    "name": "osamanagi/filament-merge-duplicates",
    "description": "Detect, review, and safely merge duplicate records in Filament apps",
    "keywords": [
        "osamanagi",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-merge-duplicates"
    ],
    "homepage": "https://github.com/osamanagi/filament-merge-duplicates",
    "support": {
        "issues": "https://github.com/osamanagi/filament-merge-duplicates/issues",
        "source": "https://github.com/osamanagi/filament-merge-duplicates"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "osamanagi",
            "email": "osamanagiworks@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.1",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.7 || ^4.0",
        "pestphp/pest-plugin-arch": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "pestphp/pest-plugin-livewire": "^3.0 || ^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Nagi\\FilamentMergeDuplicates\\": "src/",
            "Nagi\\FilamentMergeDuplicates\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nagi\\FilamentMergeDuplicates\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test",
        "test:coverage": "pest --coverage --min=100",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@test:lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nagi\\FilamentMergeDuplicates\\FilamentMergeDuplicatesServiceProvider"
            ],
            "aliases": {
                "FilamentMergeDuplicates": "Nagi\\FilamentMergeDuplicates\\Facades\\FilamentMergeDuplicates"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "prefer-stable": true
}